# Örnek değişken adlarıdır. Uygulama .env dosyasını otomatik yüklemez.
# İki token boş bırakılamaz; birbirinden farklı ve en az 32 karakter olmalıdır.

KOVAN_DB_PATH=kovan.db
KOVAN_ADMIN_TOKEN=
KOVAN_REGISTRATION_TOKEN=
KOVAN_DEFAULT_TASK_TIMEOUT_SECONDS=60
KOVAN_DEFAULT_MAX_ATTEMPTS=3
KOVAN_REAPER_INTERVAL_SECONDS=5
KOVAN_DEVICE_OFFLINE_SECONDS=35

KOVAN_CONTROLLER_URL=http://127.0.0.1:8000
KOVAN_DEVICE_ID=pc-1
KOVAN_DEVICE_TYPE=desktop
KOVAN_CAPABILITIES=sha256_file,word_count,pi_monte_carlo,prime_count
KOVAN_ALLOWED_DIRS=
KOVAN_MAX_FILE_BYTES=104857600
KOVAN_HEARTBEAT_INTERVAL=10
KOVAN_POLL_INTERVAL=2
KOVAN_REQUEST_TIMEOUT=30

# İsteğe bağlı:
# KOVAN_TOKEN_FILE=.kovan-secrets/worker-pc-1.json
# KOVAN_WORKER_TOKEN=
# KOVAN_GPU_COMPUTE_NAME=
